# --- Generic HTTP rate API (the only live rate source) ---
# No provider name is hardcoded anywhere in the engine: point these variables
# at any Gold/Silver rate API and the engine adapts.
RATE_API_URL=
RATE_API_METHOD=GET
RATE_API_INTERVAL_MS=5000
RATE_API_TIMEOUT_MS=5000
# Reject responses older than this when the API exposes a timestamp. 0 = off.
RATE_API_MAX_AGE_MS=120000
# Which normalized field becomes the live price: bid | ask | mid
RATE_API_PRICE_FIELD=bid

# --- Authentication ---
# none | query | header | bearer
RATE_API_AUTH_TYPE=query
RATE_API_KEY=
RATE_API_KEY_NAME=api_key

# Optional static extras (JSON strings)
RATE_API_HEADERS=
RATE_API_QUERY=
RATE_API_BODY=

# --- Response mapping ---
# Path to the array of quotes, e.g. "data" for { "data": [ ... ] }
RATE_API_ITEMS_PATH=data
# Field inside each item holding the instrument name
RATE_API_SYMBOL_FIELD=symbol
# Optional path to a provider timestamp
RATE_API_TIMESTAMP_PATH=

# --- Gold mapping (paths are relative to the matched item) ---
GOLD_SYMBOL=India Gold
GOLD_BID_PATH=bid
GOLD_ASK_PATH=ask
GOLD_HIGH_PATH=high
GOLD_LOW_PATH=low
GOLD_PRICE_PATH=

# --- Silver mapping ---
SILVER_SYMBOL=India Silver
SILVER_BID_PATH=bid
SILVER_ASK_PATH=ask
SILVER_HIGH_PATH=high
SILVER_LOW_PATH=low
SILVER_PRICE_PATH=

# --- Engine ---
ENABLED_TIMEFRAMES=1m
HISTORY_THROTTLE_MS=1000
# Ignore rates whose source timestamp is older than this (ms). 0 disables.
MAX_TICK_AGE_MS=120000
PORT=8080
LOG_LEVEL=info
NODE_ENV=production
