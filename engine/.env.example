# --- Angel One SmartAPI ---
ANGEL_API_KEY=K0rOB0o1
ANGEL_CLIENT_CODE=A1024927
ANGEL_PIN=5377
ANGEL_TOTP_SECRET=CKSVBEKAWY5VN34KI6URNRID4E

# Comma-separated instruments as EXCHANGE:TOKEN (mode optional, default 2 = Quote)
# Exchange codes: 1=NSE_CM 2=NSE_FO 3=BSE_CM 4=BSE_FO 5=MCX_FO 7=NCX_FO 13=CDE_FO
# Example: 5:245264,5:245265
ANGEL_INSTRUMENTS=5:466583,5:471725
ANGEL_SUBSCRIPTION_MODE=2

# --- Instrument discovery (optional) ---
# env  = (default) use ANGEL_INSTRUMENTS + METAL_TOKEN_MAP exactly as before
# auto = discover nearest active MCX GOLD/SILVER futures from Angel One's
#        OpenAPIScripMaster.json; falls back to env config if discovery fails
INSTRUMENT_DISCOVERY=auto
SCRIPMASTER_CACHE_TTL=21600000
ROLLOVER_DAYS_BEFORE_EXPIRY=2
MCX_GOLD_SYMBOL_PREFIX=GOLD
MCX_SILVER_SYMBOL_PREFIX=SILVER

# --- Automatic contract rollover (only active when INSTRUMENT_DISCOVERY=auto) ---
# Periodically re-runs discovery and switches to the new near-month contract
# without a restart. Subscribe-new-then-unsubscribe-old; never disconnects.
ROLLOVER_ENABLED=true
ROLLOVER_CHECK_INTERVAL_MS=21600000
# Wait this long for the first valid tick on the new contract before the old
# contract is unsubscribed. Default 30000, maximum 60000.
ROLLOVER_TICK_CONFIRM_TIMEOUT_MS=30000



# --- MetalpriceAPI (SECONDARY spot source: XAU, XAG, USD/INR) ---
# Set this in Railway environment variables. Leave empty to disable.
METALPRICE_API_KEY=
METALPRICE_POLL_INTERVAL_MS=300000
METALPRICE_TIMEOUT_MS=10000
METALPRICE_BASE_URL=https://api.metalpriceapi.com/v1

# --- Engine ---
ENABLED_TIMEFRAMES=1m
HISTORY_THROTTLE_MS=1000
PORT=8080
LOG_LEVEL=info
NODE_ENV=production

# Map Angel One instrument tokens to Ratan Bullion metal groups (REQUIRED)
METAL_TOKEN_MAP=466583:gold,471725:silver

# Ignore ticks whose exchange timestamp is older than this many ms (market closed /
# replayed last-trade snapshots). 0 disables the guard. Default: 120000 (2 min).
MAX_TICK_AGE_MS=120000

# --- Generic HTTP rate API (provider agnostic) ---
# The engine has NO provider-specific logic. Any Gold/Silver HTTP JSON API can
# be connected by configuration alone. Leave RATE_API_URL empty to disable.
RATE_API_URL=
RATE_API_KEY=
# none | query | header | bearer
RATE_API_AUTH_TYPE=query
# Query-param name (query auth) or header name (header auth)
RATE_API_KEY_NAME=api_key
RATE_API_METHOD=GET
# Optional static extras as JSON objects
RATE_API_HEADERS=
RATE_API_QUERY=
RATE_API_BODY=
RATE_API_INTERVAL_MS=5000
RATE_API_TIMEOUT_MS=5000
# Reject responses older than this when the API exposes a timestamp. 0 = off.
RATE_API_MAX_AGE_MS=120000
# Which normalized field becomes the live price: bid | ask | mid
RATE_API_PRICE_FIELD=bid

# --- Response mapping ---
# Path to the array of quotes (only for array-style responses)
RATE_API_ITEMS_PATH=
# Field inside each array item holding the instrument name
RATE_API_SYMBOL_FIELD=symbol
RATE_API_TIMESTAMP_PATH=

# Symbol-based lookup (array responses): set GOLD_SYMBOL / SILVER_SYMBOL and
# relative field paths. Object/nested responses: leave the symbols empty and
# use absolute paths such as data.gold.bid or data[0].bid
GOLD_SYMBOL=
GOLD_BID_PATH=
GOLD_ASK_PATH=
GOLD_HIGH_PATH=
GOLD_LOW_PATH=
GOLD_PRICE_PATH=

SILVER_SYMBOL=
SILVER_BID_PATH=
SILVER_ASK_PATH=
SILVER_HIGH_PATH=
SILVER_LOW_PATH=
SILVER_PRICE_PATH=
