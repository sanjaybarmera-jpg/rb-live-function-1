# Comma-separated instruments as EXCHANGE:TOKEN (mode optional, default 2 = Quote)
# Exchange codes: 1=NSE_CM 2=NSE_FO 3=BSE_CM 4=BSE_FO 5=MCX_FO 7=NCX_FO 13=CDE_FO
# Example: 5:245264,5:245265
ANGEL_INSTRUMENTS=5:466583,5:471725
ANGEL_SUBSCRIPTION_MODE=2

# --- Instrument discovery (optional) ---
# env  = (default) use ANGEL_INSTRUMENTS + METAL_TOKEN_MAP exactly as before
# auto = discover nearest active MCX GOLD/SILVER futures from Angel One's
#        OpenAPIScripMaster.json; falls back to env config if discovery fails
INSTRUMENT_DISCOVERY=auto
SCRIPMASTER_CACHE_TTL=21600000
ROLLOVER_DAYS_BEFORE_EXPIRY=2
MCX_GOLD_SYMBOL_PREFIX=GOLD
MCX_SILVER_SYMBOL_PREFIX=SILVER

# --- Automatic contract rollover (only active when INSTRUMENT_DISCOVERY=auto) ---
# Periodically re-runs discovery and switches to the new near-month contract
# without a restart. Subscribe-new-then-unsubscribe-old; never disconnects.
ROLLOVER_ENABLED=true
ROLLOVER_CHECK_INTERVAL_MS=21600000
# Wait this long for the first valid tick on the new contract before the old
# contract is unsubscribed. Default 30000, maximum 60000.
ROLLOVER_TICK_CONFIRM_TIMEOUT_MS=30000



# --- Engine ---
ENABLED_TIMEFRAMES=1m
HISTORY_THROTTLE_MS=1000
PORT=8080
LOG_LEVEL=info
NODE_ENV=production

# Map Angel One instrument tokens to Ratan Bullion metal groups (REQUIRED)
METAL_TOKEN_MAP=466583:gold,471725:silver

# Ignore ticks whose exchange timestamp is older than this many ms (market closed /
# replayed last-trade snapshots). 0 disables the guard. Default: 120000 (2 min).
MAX_TICK_AGE_MS=120000
