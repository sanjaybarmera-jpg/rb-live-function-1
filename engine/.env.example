# --- Generic HTTP rate API (the only live rate source) ---
# No provider name is hardcoded anywhere in the engine: point these variables
# at any Gold/Silver rate API and the engine adapts.
RATE_API_URL=
RATE_API_METHOD=GET
RATE_API_INTERVAL_MS=600
RATE_API_TIMEOUT_MS=2000
# Reject responses older than this when the API exposes a timestamp. 0 = off.
RATE_API_MAX_AGE_MS=120000
# Which normalized field becomes the live price: bid | ask | mid
RATE_API_PRICE_FIELD=bid

# --- Authentication ---
# none | query | header | bearer
RATE_API_AUTH_TYPE=query
RATE_API_KEY=
RATE_API_KEY_NAME=api_key

# Optional static extras (JSON strings)
RATE_API_HEADERS=
RATE_API_QUERY=
RATE_API_BODY=

# --- Response mapping ---
# Path to the array of quotes, e.g. "data" for { "data": [ ... ] }
RATE_API_ITEMS_PATH=data
# Field inside each item holding the provider instrument id (primary matching)
RATE_API_ID_FIELD=
# Field inside each item holding the instrument name (fallback matching)
RATE_API_SYMBOL_FIELD=symbol
# Optional path to a provider timestamp
RATE_API_TIMESTAMP_PATH=

# --- Instrument mapping (5 sources) ---
# Matching: *_ID is primary, *_SYMBOL is fallback/validation.
# Only LTP / HIGH / LOW are required; BID/ASK are legacy and optional.

# Gold Future
GOLD_ID=
GOLD_SYMBOL=India Gold
GOLD_PRICE_PATH=bid
GOLD_HIGH_PATH=high
GOLD_LOW_PATH=low
GOLD_BID_PATH=
GOLD_ASK_PATH=

# Silver Future
SILVER_ID=
SILVER_SYMBOL=India Silver
SILVER_PRICE_PATH=bid
SILVER_HIGH_PATH=high
SILVER_LOW_PATH=low
SILVER_BID_PATH=
SILVER_ASK_PATH=

# USD-INR
USD_INR_ID=
USD_INR_SYMBOL=
USD_INR_PRICE_PATH=
USD_INR_HIGH_PATH=
USD_INR_LOW_PATH=

# USD Gold
USD_GOLD_ID=
USD_GOLD_SYMBOL=
USD_GOLD_PRICE_PATH=
USD_GOLD_HIGH_PATH=
USD_GOLD_LOW_PATH=

# USD Silver
USD_SILVER_ID=
USD_SILVER_SYMBOL=
USD_SILVER_PRICE_PATH=
USD_SILVER_HIGH_PATH=
USD_SILVER_LOW_PATH=

# --- Engine ---
ENABLED_TIMEFRAMES=1m
HISTORY_THROTTLE_MS=1000
# Ignore rates whose source timestamp is older than this (ms). 0 disables.
MAX_TICK_AGE_MS=120000
PORT=8080
LOG_LEVEL=info
NODE_ENV=production

# --- SSE live stream CORS ---
# Comma-separated browser origins allowed to connect to /stream via EventSource.
# Example: https://ratanbullion.lovable.app,https://preview--xyz.lovable.app
SSE_ALLOWED_ORIGINS=https://ratanbullion.lovable.app
SSE_HEARTBEAT_MS=15000
SSE_MAX_CLIENTS=5000
